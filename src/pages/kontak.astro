---
import { actions } from 'astro:actions';
import { Mail, MapPin, Phone, Send } from '@lucide/astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import Turnstile from '../components/ui/Turnstile.astro';
import { getSettings } from '../server/settings';

const settings = await getSettings();
const user = Astro.locals.user;
const error = Astro.url.searchParams.get('error');
const sukses = Astro.url.searchParams.get('sukses');
---

<PublicLayout
  settings={settings}
  active="kontak"
  title="Kontak"
  description="Hubungi sekretariat alumni untuk pertanyaan, verifikasi, atau kerja sama."
>
  <div class="public-container" style="padding-top:2rem;padding-bottom:2rem">
    <div class="grid-2" style="grid-template-columns:minmax(0,1fr) 380px;align-items:start">
      <div>
        <p class="eyebrow">Kontak</p>
        <h1 class="page-title" style="margin-top:0.35rem">Hubungi sekretariat</h1>
        <p class="muted" style="margin:0.5rem 0 1.25rem;font-size:0.95rem;max-width:56ch">
          Untuk pertanyaan tentang keanggotaan, kartu alumni, atau kerja sama, kirim pesan melalui formulir ini.
        </p>

        {error && <div class="alert alert-error" role="alert" style="margin-bottom:1rem">{error}</div>}
        {sukses && <div class="alert alert-success" role="status" style="margin-bottom:1rem">{sukses}</div>}

        <form method="POST" action={actions.alumni.contactSupport} class="glass-panel stack" style="padding:1.4rem;gap:0.8rem">
          <div class="grid-2" style="gap:0.75rem">
            <div class="field">
              <label class="label" for="name">Nama</label>
              <input class="input" id="name" name="name" required maxlength="120" value={user?.profile?.fullName ?? ''} />
            </div>
            <div class="field">
              <label class="label" for="email">Email</label>
              <input class="input" id="email" name="email" type="email" required value={user?.email ?? ''} />
            </div>
          </div>
          <div class="field">
            <label class="label" for="subject">Subjek</label>
            <input class="input" id="subject" name="subject" maxlength="160" placeholder="Pertanyaan tentang…" />
          </div>
          <div class="field">
            <label class="label" for="message">Pesan</label>
            <textarea class="textarea" id="message" name="message" required minlength="10" maxlength="2000" rows="6" />
          </div>
          <Turnstile />
          <button class="btn btn-primary" type="submit">
            <Send size={16} stroke-width={1.9} /> Kirim pesan
          </button>
        </form>
      </div>

      <aside class="stack">
        <div class="solid-panel" style="padding:1.25rem">
          <h2 class="section-title" style="font-size:1.05rem">Informasi</h2>
          <div class="stack" style="gap:0.65rem;margin-top:0.85rem">
            {settings['site.email'] && (
              <a class="row" href={`mailto:${settings['site.email']}`} style="gap:0.55rem;font-size:0.9rem">
                <Mail size={16} stroke-width={1.8} style="color:var(--accent)" />
                {settings['site.email']}
              </a>
            )}
            {settings['site.phone'] && (
              <a class="row" href={`tel:${settings['site.phone']}`} style="gap:0.55rem;font-size:0.9rem">
                <Phone size={16} stroke-width={1.8} style="color:var(--accent)" />
                {settings['site.phone']}
              </a>
            )}
            {settings['site.address'] && (
              <p class="row" style="gap:0.55rem;font-size:0.9rem;margin:0;align-items:flex-start">
                <MapPin size={16} stroke-width={1.8} style="color:var(--accent);flex:none;margin-top:2px" />
                {settings['site.address']}
              </p>
            )}
          </div>
        </div>

        <div class="solid-panel" style="padding:1.25rem">
          <h2 class="section-title" style="font-size:1.05rem">Jam layanan</h2>
          <p class="muted" style="font-size:0.88rem;margin:0.45rem 0 0;line-height:1.6">
            Senin–Jumat, 09.00–16.00 WIB.<br />
            Pesan akan dibalas dalam 1–2 hari kerja.
          </p>
        </div>
      </aside>
    </div>
  </div>
</PublicLayout>
