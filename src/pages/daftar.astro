---
import { actions } from 'astro:actions';
import { ArrowRight, UserPlus } from '@lucide/astro';
import AuthLayout from '../layouts/AuthLayout.astro';
import Turnstile from '../components/ui/Turnstile.astro';
import { getSettings } from '../server/settings';

const settings = await getSettings();
const error = Astro.url.searchParams.get('error');
const sukses = Astro.url.searchParams.get('sukses');
const yearLabel = settings['site.year_label'];
const programLabel = settings['site.program_label'];
const nimLabel = settings['site.nim_label'];
---

<AuthLayout
  settings={settings}
  title="Daftar alumni"
  heading="Daftar sebagai alumni"
  subheading="Isi data dasar. Admin akan memverifikasi sebelum akun aktif."
>
  {error && <div class="alert alert-error" role="alert" style="margin-bottom:1rem">{error}</div>}
  {sukses && <div class="alert alert-success" role="status" style="margin-bottom:1rem">{sukses}</div>}

  <form method="POST" action={actions.auth.register} class="stack" style="gap:0.85rem">
    <div class="field">
      <label class="label" for="fullName">Nama lengkap</label>
      <input class="input" id="fullName" name="fullName" required maxlength="120" autocomplete="name" />
    </div>

    <div class="field">
      <label class="label" for="email">Email</label>
      <input class="input" id="email" name="email" type="email" required autocomplete="email" />
    </div>

    <div class="grid-2" style="gap:0.75rem">
      <div class="field">
        <label class="label" for="angkatan">{yearLabel}</label>
        <input class="input" id="angkatan" name="angkatan" inputmode="numeric" required placeholder="2015" />
      </div>
      <div class="field">
        <label class="label" for="program">{programLabel}</label>
        <input class="input" id="program" name="program" maxlength="120" />
      </div>
    </div>

    <div class="grid-2" style="gap:0.75rem">
      <div class="field">
        <label class="label" for="nim">{nimLabel}</label>
        <input class="input" id="nim" name="nim" maxlength="40" />
      </div>
      <div class="field">
        <label class="label" for="phone">Nomor HP</label>
        <input class="input" id="phone" name="phone" maxlength="30" inputmode="tel" />
      </div>
    </div>

    <label class="checkbox-row">
      <input type="checkbox" name="consent" required />
      <span>
        Saya menyetujui data saya ditampilkan di direktori sesuai <a href="/privasi">kebijakan privasi</a> yang dapat saya ubah nanti.
      </span>
    </label>

    <Turnstile />

    <button class="btn btn-primary btn-lg btn-block" type="submit">
      <UserPlus size={17} stroke-width={1.9} />
      Kirim pendaftaran
    </button>
  </form>

  <div class="divider" style="margin:1.35rem 0"></div>

  <p class="muted" style="font-size:0.88rem;margin:0">
    Sudah punya akun?{' '}
    <a href="/masuk" style="color:var(--accent);font-weight:600">Masuk di sini</a>
    <ArrowRight size={13} stroke-width={2} style="display:inline;vertical-align:-2px" />
  </p>
</AuthLayout>
