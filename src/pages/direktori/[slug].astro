---
import { actions } from 'astro:actions';
import { and, eq } from 'drizzle-orm';
import {
  ArrowLeft,
  Building,
  Globe,
  Mail,
  MapPin,
  Phone,
  Send,
  ShieldCheck,
  UserRound,
} from '@lucide/astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Avatar from '../../components/ui/Avatar.astro';
import Badge from '../../components/ui/Badge.astro';
import Turnstile from '../../components/ui/Turnstile.astro';
import { alumniProfiles, getDb, users } from '../../server/db';
import { getSettings } from '../../server/settings';
import { formatDate } from '../../server/format';
import { mediaUrl } from '../../server/storage/r2';

const { slug } = Astro.params;
const settings = await getSettings();
const db = getDb();
const viewer = Astro.locals.user;

const [profile] = await db
  .select({
    id: alumniProfiles.id,
    userId: alumniProfiles.userId,
    slug: alumniProfiles.slug,
    fullName: alumniProfiles.fullName,
    angkatan: alumniProfiles.angkatan,
    program: alumniProfiles.program,
    photoKey: alumniProfiles.photoKey,
    city: alumniProfiles.city,
    province: alumniProfiles.province,
    country: alumniProfiles.country,
    company: alumniProfiles.company,
    jobTitle: alumniProfiles.jobTitle,
    industry: alumniProfiles.industry,
    bio: alumniProfiles.bio,
    linkedinUrl: alumniProfiles.linkedinUrl,
    instagramUrl: alumniProfiles.instagramUrl,
    websiteUrl: alumniProfiles.websiteUrl,
    phone: alumniProfiles.phone,
    whatsapp: alumniProfiles.whatsapp,
    showEmail: alumniProfiles.showEmail,
    showPhone: alumniProfiles.showPhone,
    showWorkplace: alumniProfiles.showWorkplace,
    status: alumniProfiles.status,
    directoryVisible: alumniProfiles.directoryVisible,
    verifiedAt: alumniProfiles.verifiedAt,
    email: users.email,
  })
  .from(alumniProfiles)
  .innerJoin(users, eq(alumniProfiles.userId, users.id))
  .where(and(eq(alumniProfiles.slug, slug ?? ''), eq(users.status, 'active')))
  .limit(1);

const isOwner = viewer?.id === profile?.userId;
const visible =
  profile && ((profile.status === 'published' && profile.directoryVisible) || isOwner || viewer?.role === 'admin');
const member = viewer?.status === 'active';

if (!profile || !visible) {
  Astro.response.status = 404;
}

const yearLabel = settings['site.year_label'];
const feedback = Astro.url.searchParams.get('sukses') ?? Astro.url.searchParams.get('error');
const feedbackType = Astro.url.searchParams.get('error') ? 'error' : 'success';
const linkedIn = profile?.linkedinUrl;
const instagram = profile?.instagramUrl;
const website = profile?.websiteUrl;
const photo = mediaUrl(profile?.photoKey);
const profileOrigin = new URL(Astro.site ?? Astro.url).origin;

const workplace =
  profile?.showWorkplace && (profile.jobTitle || profile.company)
    ? [profile.jobTitle, profile.company].filter(Boolean).join(' · ')
    : null;
---

<PublicLayout
  settings={settings}
  active="direktori"
  title={profile ? profile.fullName : 'Profil tidak ditemukan'}
  noindex={!visible}
  image={profile?.photoKey}
  type="profile"
  jsonLd={visible && profile ? {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.fullName,
    jobTitle: profile.jobTitle ?? undefined,
    worksFor: profile.company ? { '@type': 'Organization', name: profile.company } : undefined,
    address: profile.city
      ? { '@type': 'PostalAddress', addressLocality: profile.city, addressRegion: profile.province ?? undefined, addressCountry: profile.country ?? 'Indonesia' }
      : undefined,
    url: `${profileOrigin}/direktori/${profile.slug}`,
    image: photo ? new URL(photo, profileOrigin).href : undefined,
    sameAs: [profile.linkedinUrl, profile.instagramUrl, profile.websiteUrl].filter(Boolean),
  } : undefined}
>
  {
    !profile || !visible ? (
      <div class="public-container" style="padding:4rem 1rem">
        <p class="eyebrow">404</p>
        <h1 class="page-title" style="margin-top:0.4rem">Profil tidak ditemukan</h1>
        <p class="muted">Profil mungkin sudah disembunyikan oleh pemiliknya.</p>
        <a class="btn btn-secondary" href="/direktori" style="margin-top:1rem">
          <ArrowLeft size={16} stroke-width={1.9} /> Kembali ke direktori
        </a>
      </div>
    ) : (
      <div class="public-container" style="padding-top:1.75rem;padding-bottom:2rem">
        <a class="btn btn-ghost btn-sm" href="/direktori" style="margin-bottom:1rem">
          <ArrowLeft size={15} stroke-width={2} /> Direktori
        </a>

        {feedback && (
          <div class:list={['alert', feedbackType === 'error' ? 'alert-error' : 'alert-success']} style="margin-bottom:1rem">
            {feedback}
          </div>
        )}

        <div class="glass-panel" style="padding:1.5rem">
          <div class="profile-hero">
            <Avatar src={profile.photoKey} name={profile.fullName} size="xl" />
            <div style="flex:1;min-width:240px">
              <div class="row wrap" style="gap:0.5rem">
                <h1 class="section-title" style="font-size:clamp(1.6rem,1.3rem + 1.2vw,2.1rem)">{profile.fullName}</h1>
                {profile.verifiedAt && (
                  <Badge variant="accent">
                    <ShieldCheck size={12} stroke-width={2} /> Terverifikasi
                  </Badge>
                )}
                {profile.status === 'hidden' && <Badge variant="warning">Disembunyikan</Badge>}
              </div>
              <p class="muted" style="margin:0.35rem 0 0;font-size:0.95rem">
                {yearLabel} {profile.angkatan}{profile.program ? ` · ${profile.program}` : ''}
              </p>

              <div class="meta-row" style="margin-top:0.6rem">
                {workplace && (
                  <span class="meta-item">
                    <Building size={14} stroke-width={1.8} /> {workplace}
                  </span>
                )}
                {profile.city && (
                  <span class="meta-item">
                    <MapPin size={14} stroke-width={1.8} />
                    {[profile.city, profile.province].filter(Boolean).join(', ')}
                  </span>
                )}
                {profile.industry && <span class="badge">{profile.industry}</span>}
              </div>
            </div>
          </div>

          {profile.bio && (
            <p style="margin:1.35rem 0 0;color:var(--text-secondary);line-height:1.65;font-size:0.98rem;max-width:75ch">
              {profile.bio}
            </p>
          )}

          <div class="row wrap" style="margin-top:1rem;gap:0.5rem">
            {
              linkedIn && (
                <a class="chip" href={linkedIn} target="_blank" rel="noopener noreferrer">
                  <Globe size={14} /> LinkedIn
                </a>
              )
            }
            {
              instagram && (
                <a class="chip" href={instagram} target="_blank" rel="noopener noreferrer">
                  <Globe size={14} /> Instagram
                </a>
              )
            }
            {
              website && (
                <a class="chip" href={website} target="_blank" rel="noopener noreferrer">
                  <Globe size={14} /> Situs web
                </a>
              )
            }
          </div>
        </div>

        <div class="grid-2" style="margin-top:1.25rem">
          <section class="solid-panel" style="padding:1.25rem">
            <h2 class="section-title" style="font-size:1.05rem">Kontak</h2>
            <p class="muted" style="font-size:0.82rem;margin:0.3rem 0 0.85rem">
              Detail kontak hanya ditampilkan untuk anggota yang sudah masuk.
            </p>

            {member ? (
              <div class="stack" style="gap:0.5rem">
                {profile.showEmail ? (
                  <a class="list-row" href={`mailto:${profile.email}`} style="padding:0.6rem 0;border:0">
                    <Mail size={16} stroke-width={1.8} />
                    <span style="font-size:0.9rem">{profile.email}</span>
                  </a>
                ) : (
                  <p class="muted" style="font-size:0.86rem;margin:0">Email tidak dibagikan publik.</p>
                )}
                {profile.showPhone && profile.phone && (
                  <a class="list-row" href={`tel:${profile.phone}`} style="padding:0.6rem 0;border:0">
                    <Phone size={16} stroke-width={1.8} />
                    <span style="font-size:0.9rem">{profile.phone}</span>
                  </a>
                )}
                {profile.showPhone && profile.whatsapp && (
                  <a
                    class="list-row"
                    href={`https://wa.me/${profile.whatsapp.replace(/[^0-9]/g, '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="padding:0.6rem 0;border:0"
                  >
                    <Phone size={16} stroke-width={1.8} />
                    <span style="font-size:0.9rem">WhatsApp</span>
                  </a>
                )}
                <p class="hint">Terakhir diperbarui {formatDate(profile.verifiedAt)}.</p>
              </div>
            ) : viewer ? (
              <p class="muted" style="font-size:0.88rem;margin:0">
                Kontak ditampilkan setelah akun Anda diverifikasi admin.
              </p>
            ) : (
              <div>
                <p class="muted" style="font-size:0.88rem;margin:0 0 0.75rem">
                  Masuk sebagai alumni untuk melihat kontak atau mengirim pesan.
                </p>
                <a class="btn btn-primary btn-sm" href={`/masuk?next=/direktori/${profile.slug}`}>Masuk</a>
              </div>
            )}
          </section>

          <section class="solid-panel" style="padding:1.25rem">
            <h2 class="section-title" style="font-size:1.05rem">Kirim pesan</h2>
            {member && !isOwner ? (
              <form method="POST" action={actions.alumni.contact} class="stack" style="gap:0.6rem;margin-top:0.75rem">
                <input type="hidden" name="slug" value={profile.slug} />
                <div class="field">
                  <label class="label" for="contact-name">Nama</label>
                  <input
                    class="input"
                    id="contact-name"
                    name="name"
                    required
                    maxlength="120"
                    value={viewer.profile?.fullName ?? ''}
                  />
                </div>
                <div class="field">
                  <label class="label" for="contact-email">Email</label>
                  <input class="input" id="contact-email" name="email" type="email" readonly value={viewer.email} />
                </div>
                <div class="field">
                  <label class="label" for="contact-subject">Subjek</label>
                  <input class="input" id="contact-subject" name="subject" maxlength="160" placeholder="Opsional" />
                </div>
                <div class="field">
                  <label class="label" for="contact-message">Pesan</label>
                  <textarea class="textarea" id="contact-message" name="message" required minlength="10" maxlength="2000" />
                </div>
                <Turnstile />
                <button class="btn btn-primary" type="submit">
                  <Send size={16} stroke-width={1.9} /> Kirim pesan
                </button>
              </form>
            ) : viewer && isOwner ? (
              <p class="muted" style="font-size:0.88rem">
                Ini profil Anda. Ubah visibilitas kontak melalui <a href="/akun/profil" style="color:var(--accent)">pengaturan profil</a>.
              </p>
            ) : viewer ? (
              <p class="muted" style="font-size:0.88rem">
                Akun Anda masih menunggu verifikasi admin sebelum bisa mengirim pesan.
              </p>
            ) : (
              <div>
                <p class="muted" style="font-size:0.88rem;margin:0 0 0.75rem">
                  Masuk untuk menghubungi alumni ini tanpa membuka alamat email Anda ke publik.
                </p>
                <a class="btn btn-secondary btn-sm" href={`/masuk?next=/direktori/${profile.slug}`}>
                  <UserRound size={15} stroke-width={1.9} /> Masuk sebagai alumni
                </a>
              </div>
            )}
          </section>
        </div>
      </div>
    )
  }
</PublicLayout>
