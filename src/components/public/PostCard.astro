---
import { ArrowRight } from '@lucide/astro';
import { formatDate } from '../../server/format';
import { mediaUrl } from '../../server/storage/r2';

interface Props {
  post: {
    slug: string;
    title: string;
    excerpt: string | null;
    coverKey: string | null;
    category: string | null;
    publishedAt: number | null;
  };
}

const { post } = Astro.props;
const cover = mediaUrl(post.coverKey);
---

<a class="card card-hover" href={`/berita/${post.slug}`} style="display:flex;flex-direction:column;overflow:hidden">
  <div style="aspect-ratio:16/9;background:linear-gradient(135deg,var(--accent-soft),transparent)">
    {
      cover ? (
        <img class="cover-img" src={cover} alt="" loading="lazy" decoding="async" />
      ) : (
        <div
          style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:650;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent)"
        >
          {post.category ?? 'Berita'}
        </div>
      )
    }
  </div>
  <div style="padding:1rem 1.1rem 1.15rem;display:flex;flex-direction:column;gap:0.4rem;flex:1">
    <div class="row wrap" style="gap:0.4rem">
      {post.category && <span class="badge badge-accent">{post.category}</span>}
      <span class="tertiary" style="font-size:0.76rem">{formatDate(post.publishedAt)}</span>
    </div>
    <strong class="clamp-2" style="font-size:1rem;letter-spacing:-0.015em;line-height:1.3">{post.title}</strong>
    {post.excerpt && <p class="muted clamp-2" style="margin:0;font-size:0.86rem">{post.excerpt}</p>}
    <span class="row" style="gap:0.3rem;margin-top:auto;padding-top:0.6rem;color:var(--accent);font-size:0.83rem;font-weight:600">
      Baca <ArrowRight size={14} stroke-width={2} />
    </span>
  </div>
</a>
