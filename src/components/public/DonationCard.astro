---
import { ArrowRight, Heart } from '@lucide/astro';
import { formatDate } from '../../server/format';
import { formatRupiah, formatNumber } from '../../server/util';

interface Props {
  campaign: {
    slug: string;
    title: string;
    targetAmount: number;
    deadline: number | null;
    status: string;
  };
  collected: number;
}

const { campaign, collected } = Astro.props;
const percent = campaign.targetAmount > 0 ? Math.min(100, Math.round((collected / campaign.targetAmount) * 100)) : 0;
---

<a class="card card-hover" href={`/donasi/${campaign.slug}`} style="display:block;padding:1.15rem">
  <div class="row spread" style="gap:0.75rem;align-items:flex-start">
    <div class="row" style="gap:0.6rem;align-items:flex-start">
      <span
        style="width:38px;height:38px;border-radius:11px;background:var(--success-soft);color:var(--success);display:flex;align-items:center;justify-content:center;flex:none"
      >
        <Heart size={18} stroke-width={1.9} />
      </span>
      <div>
        <strong style="font-size:0.96rem;display:block;line-height:1.3">{campaign.title}</strong>
        {campaign.deadline && (
          <span class="tertiary" style="font-size:0.76rem">Hingga {formatDate(campaign.deadline)}</span>
        )}
      </div>
    </div>
    <ArrowRight size={16} stroke-width={2} style="color:var(--text-tertiary);flex:none" />
  </div>

  <div
    class="progress"
    style="margin-top:0.9rem"
    role="progressbar"
    aria-label="Dana terkumpul"
    aria-valuenow={percent}
    aria-valuemin="0"
    aria-valuemax="100"
  >
    <span style={`width:${percent}%`}></span>
  </div>
  <div class="spread" style="margin-top:0.45rem;font-size:0.78rem">
    <span style="font-weight:650">{formatRupiah(collected)}</span>
    <span class="tertiary">{formatNumber(percent)}% dari {formatRupiah(campaign.targetAmount)}</span>
  </div>
</a>
