---
import { MapPin, Users } from '@lucide/astro';
import Badge from '../ui/Badge.astro';
import { formatDate, formatTime } from '../../server/format';

interface Props {
  event: {
    slug: string;
    title: string;
    location: string | null;
    mode: 'offline' | 'online' | 'hybrid';
    startsAt: number;
    capacity: number | null;
    coverKey: string | null;
  };
  registered?: number;
}

const { event, registered } = Astro.props;
const date = new Date(event.startsAt);
const day = new Intl.DateTimeFormat('id-ID', { day: '2-digit' }).format(date);
const month = new Intl.DateTimeFormat('id-ID', { month: 'short' }).format(date);
const modeLabel: Record<string, string> = { offline: 'Offline', online: 'Online', hybrid: 'Hybrid' };
---

<a class="card card-hover" href={`/agenda/${event.slug}`} style="display:flex;gap:1rem;padding:1rem;align-items:flex-start">
  <div
    style="width:58px;flex:none;text-align:center;border-radius:14px;padding:0.5rem 0;background:var(--accent-soft);color:var(--accent)"
  >
    <div style="font-size:1.25rem;font-weight:750;line-height:1">{day}</div>
    <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em">{month}</div>
  </div>
  <div style="min-width:0;flex:1">
    <strong class="clamp-2" style="font-size:0.97rem;line-height:1.3;display:block">{event.title}</strong>
    <p class="muted" style="margin:0.2rem 0 0;font-size:0.82rem">
      {formatDate(event.startsAt)} · {formatTime(event.startsAt)} WIB
    </p>
    <div class="meta-row" style="margin-top:0.4rem">
      <span class="badge">{modeLabel[event.mode]}</span>
      {
        event.location && (
          <span class="meta-item">
            <MapPin size={13} stroke-width={1.8} /> {event.location}
          </span>
        )
      }
      {
        event.capacity && (
          <span class="meta-item">
            <Users size={13} stroke-width={1.8} /> {registered ?? 0}/{event.capacity}
          </span>
        )
      }
    </div>
  </div>
</a>
