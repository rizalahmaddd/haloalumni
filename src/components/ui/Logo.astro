---
interface Props {
  name: string;
  logoUrl?: string | null;
  size?: number;
  markOnly?: boolean;
}

const { name, logoUrl, size = 32, markOnly = false } = Astro.props;
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .map((word) => word[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<span class="brand-lockup">
  <span class="logo-mark" style={`width:${size}px;height:${size}px;font-size:${size * 0.4}px`}>
    {
      logoUrl ? (
        <img src={logoUrl} alt="" width={size} height={size} />
      ) : (
        <span aria-hidden="true">{initials}</span>
      )
    }
  </span>
  {!markOnly && <span class="brand-name">{name}</span>}
</span>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }

  .brand-name {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 190px;
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border-radius: 30%;
    font-weight: 750;
    color: #fff;
    overflow: hidden;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--accent) 70%, white),
      var(--accent) 55%,
      color-mix(in srgb, var(--accent) 65%, black)
    );
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 4px 12px -4px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .logo-mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
